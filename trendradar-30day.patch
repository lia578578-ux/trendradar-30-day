@@ -9,6 +9,7 @@
 Author: TrendRadar Team
 """
 
+from datetime import date, datetime, timedelta
 from typing import Dict, List, Tuple, Optional
 
 
@@ -110,6 +111,109 @@ def read_all_today_titles(
     return all_results, final_id_to_name, title_info
 
 
+def read_recent_titles(
+    storage_manager,
+    days: int = 30,
+    current_platform_ids: Optional[List[str]] = None,
+    end_date: Optional[str] = None,
+    quiet: bool = False,
+) -> Tuple[Dict, Dict, Dict]:
+    """
+    读取滚动时间窗口内的热榜数据并跨天聚合。
+
+    相同平台下标题相同的条目视为同一热点；排名范围去重合并，
+    抓取次数累加，首次/末次出现时间附带日期，便于 HTML 展示。
+    """
+    days = max(1, min(int(days), 365))
+    if end_date:
+        end = datetime.strptime(end_date, "%Y-%m-%d").date()
+    else:
+        end = date.today()
+    start = end - timedelta(days=days - 1)
+
+    results: Dict = {}
+    id_to_name: Dict = {}
+    title_info: Dict = {}
+    loaded_days = 0
+
+    for offset in range(days):
+        current_date = start + timedelta(days=offset)
+        date_str = current_date.isoformat()
+        news_data = storage_manager.get_today_all_data(date_str)
+        if not news_data or not news_data.items:
+            continue
+        loaded_days += 1
+
+        for source_id, news_list in news_data.items.items():
+            if (
+                current_platform_ids is not None
+                and source_id not in current_platform_ids
+            ):
+                continue
+
+            id_to_name[source_id] = news_data.id_to_name.get(source_id, source_id)
+            source_results = results.setdefault(source_id, {})
+            source_info = title_info.setdefault(source_id, {})
+
+            for item in news_list:
+                title = item.title
+                ranks = item.ranks or ([item.rank] if item.rank else [])
+                first_time = item.first_time or item.crawl_time
+                last_time = item.last_time or item.crawl_time
+                dated_first = f"{date_str[5:]} {first_time}" if first_time else date_str[5:]
+                dated_last = f"{date_str[5:]} {last_time}" if last_time else date_str[5:]
+                dated_timeline = [
+                    {
+                        **point,
+                        "time": f"{date_str[5:]} {point.get('time', '')}".strip(),
+                    }
+                    for point in (item.rank_timeline or [])
+                ]
+
+                if title not in source_results:
+                    source_results[title] = {
+                        "ranks": sorted(set(ranks)),
+                        "url": item.url or "",
+                        "mobileUrl": item.mobile_url or "",
+                    }
+                    source_info[title] = {
+                        "first_time": dated_first,
+                        "last_time": dated_last,
+                        "count": item.count,
+                        "ranks": sorted(set(ranks)),
+                        "url": item.url or "",
+                        "mobileUrl": item.mobile_url or "",
+                        "rank_timeline": dated_timeline,
+                    }
+                    continue
+
+                existing = source_info[title]
+                merged_ranks = sorted(set(existing.get("ranks", [])) | set(ranks))
+                existing["ranks"] = merged_ranks
+                existing["count"] = existing.get("count", 0) + item.count
+                existing["last_time"] = dated_last
+                existing["rank_timeline"].extend(dated_timeline)
+                if item.url:
+                    existing["url"] = item.url
+                if item.mobile_url:
+                    existing["mobileUrl"] = item.mobile_url
+
+                source_results[title] = {
+                    "ranks": merged_ranks,
+                    "url": existing.get("url", ""),
+                    "mobileUrl": existing.get("mobileUrl", ""),
+                }
+
+    if not quiet:
+        total_count = sum(len(titles) for titles in results.values())
+        print(
+            f"[存储] 近 {days} 天窗口 {start.isoformat()} ~ {end.isoformat()}："
+            f"读取 {loaded_days} 天数据，聚合为 {total_count} 条热点"
+        )
+
+    return results, id_to_name, title_info
+
+
 def detect_latest_new_titles_from_storage(
     storage_manager,
     current_platform_ids: Optional[List[str]] = None,
